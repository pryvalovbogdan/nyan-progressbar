#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Lint staged files
npx lint-staged

# TypeScript type check
echo "\n📐 TypeScript check..."
npx tsc --noEmit --pretty 2>&1
TSC_STATUS=$?
if [ $TSC_STATUS -ne 0 ]; then
  echo "❌ TypeScript errors found. Fix them before committing."
  exit 1
fi
echo "✅ TypeScript OK"
